# =============================================================================
# GenIQ Go Backend - example configuration
# Copy this file to ".env" and adjust the values for your environment.
# The backend reads .env from the working directory on startup.
# Every variable is optional; the defaults shown below are sane.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Address the HTTP server binds to.
HOST=0.0.0.0
# Port the HTTP server listens on.
PORT=8000


# -----------------------------------------------------------------------------
# LLM (OpenAI-compatible chat completion server)
# -----------------------------------------------------------------------------
# Model name understood by the server at LLM_BASE_URL.
LLM_MODEL=gpt-4o
# Passphrase presented to the server (dummy when using a local server).
LLM_API_KEY=sk-placeholder
# Base URL of the OpenAI-compatible chat endpoint. Empty = no base path
# appended; the server typically supplies its own (e.g. llama.cpp /v1).
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Sampling temperature in [0,1]. Higher = more creative.
LLM_TEMPERATURE=0.1


# -----------------------------------------------------------------------------
# MCP (structured-data search server)
#
# Transport priority (highest wins):
#   1. MCP_ENDPOINT  : streamable-HTTP MCP endpoint (http://host:port/mcp).
#   2. MCP_TOOL_EXEC_CMD : verbatim command template used to launch a stdio
#                         MCP server (tokens ${tool}, ${args}, ${workdir}).
#   3. MCP_SERVER_PATH : legacy stdio server binary path (fallback).
# If none are set the app falls back to MCP_SERVER_PATH="geniq-mcp-server".
# -----------------------------------------------------------------------------
MCP_ENABLED=true
# 1) Streamable HTTP MCP endpoint (takes precedence over everything below).
#MCP_ENDPOINT=http://127.0.0.1:8780/mcp
# 2) Verbatim command template to launch a stdio MCP server. Optional.
#   ${tool}  -> tool/binary name, ${args} -> tool args, ${workdir} -> cwd.
#MCP_TOOL_EXEC_CMD=${tool} ${args} --cwd ${workdir}
# 3) Path to the stdio MCP server binary (legacy).
MCP_SERVER_PATH=geniq-mcp-server
# Working directory passed to the stdio MCP server process.
#MCP_WORK_DIR=


# -----------------------------------------------------------------------------
# MCP block list
# -----------------------------------------------------------------------------
# Comma-separated list of tool-name filters (regex or plain substring).
# Any tool whose name matches is filtered out of the model's available tools
# AND rejected if a call is attempted. Empty = no blocks.
#MCP_BLOCK_LIST=delete_.*,danger_


# -----------------------------------------------------------------------------
# Confluence
# -----------------------------------------------------------------------------
# Base URL of the Confluence site.
CONFLUENCE_BASE_URL=https://your-org.atlassian.net
# Auth mode for API calls: "basic" (username/password) or "bearer" (PAT,
# required for Confluence Data Center).
CONFLUENCE_AUTH_MODE=bearer
# Username for basic auth (not used with bearer).
#CONFLUENCE_USERNAME=your-confluence-username
# Password or personal access token for basic auth (not used with bearer).
#CONFLUENCE_API_TOKEN=your-api-token


# -----------------------------------------------------------------------------
# RAG (vector search via sqlite-vec + external embeddings)
# -----------------------------------------------------------------------------
# Enable or disable RAG entirely.
RAG_ENABLED=true
# RAG_DB_PATH is a *directory* that holds the SQLite vector store. The store
# file is resolved as <RAG_DB_PATH>/rags.db (the same convention the /ragdir
# command and the backend config use).
#RAG_DB_PATH=./rag-db
# Directory scanned for documents to index for search.
#RAG_DOCS_DIR=./resources/rag_documents
# Embedding model name understood by EMBEDDING_BASE_URL.
#RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Chunk size in characters for document splitting.
RAG_CHUNK_SIZE=1500
# Chunk overlap in characters.
RAG_CHUNK_OVERLAP=300
# Max number of nearest-neighbor documents returned per query.
RAG_SEARCH_LIMIT=5
# Minimum similarity score for a chunk to be returned (0.0-1.0).
RAG_SCORE_THRESHOLD=0.25


# -----------------------------------------------------------------------------
# Embeddings (OpenAI-compatible /v1/embeddings)
# -----------------------------------------------------------------------------
# Embedding endpoint. Defaults to LLM_BASE_URL (minus a trailing /v1) when empty.
EMBEDDING_BASE_URL=
# Embedding API key. Defaults to LLM_API_KEY when empty.
EMBEDDING_API_KEY=sk-placeholder
# Dimension of the embedding vectors produced by EMBEDDING_BASE_URL.
EMBEDDING_DIM=384


# -----------------------------------------------------------------------------
# Application datastore (users, conversations, messages)
# -----------------------------------------------------------------------------
# SQLite file for the application DB.
#DB_PATH=./.sonic.db
# DB driver. "sqlite3" (default) or a registered PostgreSQL driver name.
DB_DRIVER=sqlite3


# -----------------------------------------------------------------------------
# JWT (authentication)
# -----------------------------------------------------------------------------
# Secret used to sign/verify JWTs. Provide a strong random value in production.
#JWT_SECRET=
# Path to a file containing the JWT secret (alternative to JWT_SECRET).
#JWT_SECRET_FILE=


# -----------------------------------------------------------------------------
# CORS (HTTP middleware for browser-based frontends, e.g. the Wails WebView)
# All knobs are optional; defaults are permissive enough for the Wails app.
# Set CORS_ENABLED=false to disable the middleware entirely.
# -----------------------------------------------------------------------------
CORS_ENABLED=true
# Access-Control-Allow-Origin. "*" for any origin, a specific origin, or ":"
# to reflect the request origin (needed with credentials).
CORS_ORIGIN=*
# Access-Control-Allow-Methods.
CORS_METHODS=GET, POST, PUT, DELETE, OPTIONS, PATCH
# Access-Control-Allow-Headers.
CORS_ALLOW_HEADERS=Content-Type, Authorization, Accept
# Access-Control-Max-Age in seconds for preflight caching.
CORS_MAX_AGE=3600
# Access-Control-Allow-Credentials: true.
CORS_ALLOW_CREDENTIALS=false


# -----------------------------------------------------------------------------
# Model-driven tool-use (function calling)
# -----------------------------------------------------------------------------
# Selects the mode used when a model turn is served with or without tools:
#   "false" = hybrid-only: always use ContextBuilder (default baseline)
#   "true"  = tool-use-only: always hand tools to the model
#   "auto"  = probe-then-use: run the capability probe and pick per-request
FEATURE_TOOL_USE=false
# Caps how many tool-call + re-request rounds the loop performs per user turn
# (guards against runaway tool loops). 0 or negative uses the default (5).
MODEL_MAX_TOOL_CALLS=5


# -----------------------------------------------------------------------------
# Frontend (static SPA)
# -----------------------------------------------------------------------------
# Path to the built SPA directory to serve. Also accepts a second CLI arg:
#   backend-go <.env-or-empty> <frontend-path>
# Leave empty to disable serving the frontend.
#FRONTEND_PATH=../frontend/spa/dist
