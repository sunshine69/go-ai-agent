
# CORS (HTTP middleware for browser-based frontends, e.g. the Wails WebView at
# origin "wails://"). Every knob is dotenv-configurable. Defaults are already
# permissive enough that no changes are needed to make the Wails app work.
# Set CORS_ENABLED=false to disable the middleware entirely (no CORS headers).
CORS_ENABLED=true
# Access-Control-Allow-Origin. Use "*" for any origin, or a specific origin.
# Use ":" to reflect the request origin (needed with credentials).
CORS_ORIGIN=*
# Access-Control-Allow-Methods
CORS_METHODS=GET, POST, PUT, DELETE, OPTIONS, PATCH
# Access-Control-Allow-Headers
CORS_ALLOW_HEADERS=Content-Type, Authorization, Accept
# Access-Control-Max-Age (seconds) for preflight caching
CORS_MAX_AGE=3600
# Access-Control-Allow-Credentials: true
CORS_ALLOW_CREDENTIALS=false
# GenIQ Go Backend Configuration

# Server
HOST=0.0.0.0
PORT=8066
DEBUG=true

# LLM (llama.cpp local server)
#LLM_MODEL=gemma4edge1
LLM_MODEL=ornith-free
LLM_API_KEY=dummy-key
LLM_TEMPERATURE=0.6
#LLM_BASE_URL=http://192.168.20.52:11434/v1
LLM_BASE_URL=http://localhost:9999/v1

# MCP search (structured data) - disabled to match Python .env
MCP_ENABLED=true
MCP_SERVER_PATH=../../mcp-server/geniq-mcp-server

# Confluence
CONFLUENCE_BASE_URL=https://your-org.atlassian.net

# RAG (vector search) - enabled, embeddings from local llama.cpp
RAG_ENABLED=true
RAG_DB_PATH=rag-db/rags_e2e.db
RAG_DOCS_DIR=../../resources/rag_documents
RAG_EMBEDDING_MODEL=nomic-embed
EMBEDDING_BASE_URL=http://localhost:9999/v1
EMBEDDING_DIM=768
RAG_SCORE_THRESHOLD=0.82
