# SupersonicIQ Configuration

# Server
APP_NAME=SuperSonicIQ
HOST=0.0.0.0
PORT=8000
DEBUG=true

# LLM (change to match your local server)
LLM_PROVIDER=openai
LLM_MODEL=qwopus-mtp
LLM_API_KEY=dummy-key           # not needed for local servers, but litellm requires it
LLM_TEMPERATURE=0.1

# For OpenAI-compatible local LLM (e.g., llama-cpp-server):
# Set LLM_BASE_URL to your local server URL
LLM_BASE_URL=http://192.168.20.23:11434/v1

# For Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# For vLLM:
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# For Azure OpenAI:
# LLM_PROVIDER=azure
# LLM_MODEL=gpt-4-0613
# LLM_API_KEY=your-azure-key

# For OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-3.5-turbo

# MCP Server Should auto detect it. If set in here then it must be absolute paths.
# MCP_SERVER_PATH=/mcp-server/supersoniciq-mcp-server
MCP_TRANSPORT=stdio

# Confluence
CONFLUENCE_BASE_URL=https://sonichealthcare.atlassian.net
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_USERNAME=your-confluence-username
# "basic" (default) = Confluence Cloud, email + API token. "bearer" = Confluence Data Center/Server, Personal Access Token (username not required).
CONFLUENCE_AUTH_MODE=basic

# Document paths. Should auto detect. If set in here then it must be absolute paths.
#DOCUMENTS_BASE_PATH=../../resources/documents
#SKILLS_DIR_PATH=../../documents/skills/skills_directory.json
#PROC_DIR_PATH=../../documents/skills/processes.json

# RAG (vector search) - set to false to disable (no embedding model needed)
RAG_ENABLED=true

# MCP search - set to false to disable MCP and use RAG only (no Go MCP subprocess needed)
MCP_ENABLED=true

LITELLM_LOCAL_MODEL_COST_MAP=true
SSL_CERT_FILE=/home/sitsxk5/tmp/tls-ca-bundle.pem
